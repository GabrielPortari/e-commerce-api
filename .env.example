# In production, set SPRING_PROFILES_ACTIVE=prod so the app refuses to boot
# if JWT_SECRET/DB_PASSWORD were left at their dev defaults below.
SPRING_PROFILES_ACTIVE=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional: only used on first boot when no ADMIN user exists yet. Set both
# to create the initial admin account, then remove them (or leave unset).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
